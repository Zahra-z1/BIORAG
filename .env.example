# Retrieval
TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=220
RELEVANCE_THRESHOLD=0.22
ENABLE_SEMANTIC=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Answer generation: auto | transformers | extractive
GENERATION_BACKEND=auto
GENERATION_MODEL=google/flan-t5-base
MAX_NEW_TOKENS=420
MAX_CONTEXT_CHARS=12000

# Set true if Hugging Face is allowed to download missing local models.
ALLOW_MODEL_DOWNLOAD=true
