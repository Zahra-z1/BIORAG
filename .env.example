# Retrieval output
TOP_K=6

# PDF chunking
CHUNK_SIZE=1400
CHUNK_OVERLAP=250

# Candidate retrieval
LEXICAL_CANDIDATES=80
SEMANTIC_CANDIDATES=80
RERANK_CANDIDATES=60

# Relevance
RELEVANCE_THRESHOLD=0.20

# Dense semantic retrieval
ENABLE_SEMANTIC=true
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1

# CrossEncoder reranking
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Answer extraction
ANSWER_WINDOW_COUNT=5
ANSWER_WINDOW_THRESHOLD=0.12

# Keep this extractive for now.
GENERATION_BACKEND=extractive
GENERATION_MODEL=google/flan-t5-base


MAX_NEW_TOKENS=420
MAX_CONTEXT_CHARS=12000

ALLOW_MODEL_DOWNLOAD=true
ENABLE_QA_EXTRACTOR=true
QA_MODEL=deepset/minilm-uncased-squad2
QA_TOP_CONTEXTS=5
QA_MIN_SCORE=0.06